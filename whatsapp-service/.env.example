# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env dosyasını ASLA git'e ekleme veya paylaşma — gizli anahtarlar içerir.

# Vercel'de yayınlanan sitenin adresi (sonunda / olmadan)
YONTUM_SITE_URL=https://yontum.vercel.app

# Vercel'e WHATSAPP_SERVICE_SECRET olarak eklediğin, bu servisin kimliğini
# doğrulayan gizli anahtar (Ahmet sana bu değeri ayrıca iletecek).
WHATSAPP_SERVICE_SECRET=

# Vercel API'sini kontrol etme sıklığı (milisaniye). 60000 = 1 dakika.
POLL_INTERVAL_MS=60000
